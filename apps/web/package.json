{
  "name": "@vetpulse/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "VetPulse web client: case management, sample tracking and data-quality dashboards",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "oxlint": "^1.10.0",
    "typescript": "~5.7.3",
    "vite": "^6.0.5",
    "vitest": "^3.0.2"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
